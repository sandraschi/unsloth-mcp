# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.pyright/

# Node / webapp
node_modules/
**/node_modules/
*.tsbuildinfo

# Rust / Tauri (fleet default even without native/)
target/
native/target/
web_sota/src-tauri/target/
gen/

# Build output
dist/
build/
*.mcpb

# MCPB pack staging (exact copy of src/ for packing - never commit)
mcpb/src/
# MCPB pack-synced derivatives (regenerated from root on every pack run)
mcpb/assets/prompts/
mcpb/.mcpbignore

# Data / DB (jobs, sqlite, datasets, models)
data/
*.db
*.db-shm
*.db-wal

# Secrets
.env
.env.*
*.pem

# Logs / caches
*.log
logs/
cua-reports/
.coverage
coverage.xml

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Fleet backup patterns (always ignore both)
*.bak
*.bak.*

# Assfix working snapshots (regenerable - the committed copy lives in docs/assess-reports/)
reports/
